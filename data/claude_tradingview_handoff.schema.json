{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infoyuusuke-afk.github.io/trade-cockpit/schema/claude_tradingview_handoff.schema.json",
  "title": "Claude TradingView Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "bars"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "timeframe",
        "retrieved_at",
        "timezone"
      ],
      "properties": {
        "symbol": {
          "const": "TSE:285A"
        },
        "timeframe": {
          "const": "15S"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Asia/Tokyo"
        }
      }
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
