    "open_gap_pct":{"type":"number"},
    "dex_0800":{"type":["number","null"]},"dex_0830":{"type":["number","null"]},
    "dex_0845":{"type":["number","null"]},"dex_0855":{"type":["number","null"]},
    "dex_0800_gap_pct":{"type":["number","null"]},"dex_0830_gap_pct":{"type":["number","null"]},
    "dex_0845_gap_pct":{"type":["number","null"]},"dex_0855_gap_pct":{"type":["number","null"]},
    "open_to_or5_pct":{"type":"number"},"or5_to_or15_pct":{"type":"number"},
    "open_to_0930_pct":{"type":"number"},"open_to_1000_pct":{"type":"number"},
