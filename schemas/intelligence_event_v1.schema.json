{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/100b/intelligence_event_v1.schema.json",
  "title": "100億PROJECT GNH01 intelligence_event_v1 (research-only)",
  "description": "Offline structural contract. Semantic time ordering, canonical SHA256 and independent source verification are enforced separately by scripts/gnh01_intelligence_contract_v1.py. Schema validation is NOT source authentication or permission to simulate/submit an order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "source_role", "original_source_url",
    "original_issuer", "event_type", "affected_region", "published_at",
    "provider_available_at", "grok_first_seen_at", "grok_reported_at",
    "bridge_received_at", "event_title", "event_summary",
    "related_japanese_stocks", "evidence_status", "novelty_status",
    "content_hash", "event_revision", "data_lane", "real_submit_allowed"
  ],
  "$defs": {
    "utcTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"},
    "nullableUtcTime": {"oneOf": [{"$ref": "#/$defs/utcTime"}, {"type": "null"}]}
  },
  "properties": {
    "schema_version": {"const": "intelligence_event_v1"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,96}$"},
    "source_role": {"enum": ["grok_bot_gnh01", "owner_instruction_relay"]},
    "original_source_url": {"type": "string", "minLength": 12, "maxLength": 600},
    "original_issuer": {"type": "string", "minLength": 1, "maxLength": 160},
    "event_type": {"enum": ["NEWS", "IR", "PUBLIC_SOCIAL", "MACRO", "CORRECTION"]},
    "affected_region": {"type": "string", "minLength": 1, "maxLength": 80},
    "published_at": {"$ref": "#/$defs/nullableUtcTime"},
    "provider_available_at": {"$ref": "#/$defs/nullableUtcTime"},
    "grok_first_seen_at": {"$ref": "#/$defs/nullableUtcTime"},
    "grok_reported_at": {"$ref": "#/$defs/nullableUtcTime"},
    "bridge_received_at": {"$ref": "#/$defs/utcTime"},
    "event_title": {"type": "string", "minLength": 1, "maxLength": 240},
    "event_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "related_japanese_stocks": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["security_code", "official_company_name"],
        "properties": {
          "security_code": {"type": "string", "pattern": "^([0-9]{4}|[0-9]{3}[A-Z])(\\.T)?$"},
          "official_company_name": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "evidence_status": {"enum": ["PRIMARY_VERIFIED", "SECONDARY_VERIFIED", "UNVERIFIED", "CONTRADICTED", "STALE", "INVALIDATED"]},
    "novelty_status": {"enum": ["TRUE_NEW", "MATERIAL_UPDATE", "MISSED_PREVIOUS", "RECONFIRMATION"]},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "data_lane": {"const": "PUBLIC_RESEARCH_UNAUTHENTICATED_NOT_EXECUTION"},
    "real_submit_allowed": {"const": false}
  }
}
