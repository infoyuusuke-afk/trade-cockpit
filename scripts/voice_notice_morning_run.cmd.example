@echo off
rem OWNER 2026-11-08: morning voice notice (08:40 on weekdays). Speaks only; it cannot order.
rem Copy this file next to voice_notice.py on the PC, fill in the three paths, and register it only after the audit passes.
set PY=<python.exe>
set FILES=<MarketSpeed II RSS files folder>
set BRAIN=<research folder>
"%PY%" -I "%~dp0voice_notice.py" morning --files "%FILES%" --brain "%BRAIN%" >> "%~dp0voice_notice.log" 2>&1
